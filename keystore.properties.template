# Release signing credentials for this fork's sideloaded APKs (GitHub Releases — see docs/fork-release.md).
#
# Copy this file to `keystore.properties` (same directory, repo root) and fill in the real values.
# `keystore.properties` is gitignored and must NEVER be committed.
#
# IMPORTANT: this fork signs with its OWN key — the upstream Play upload key is not available here,
# and there is no Play listing to serve. Users update by sideloading (Obtainium), which checks only
# the package id and the signing certificate, so the SAME release.jks must be used for every release:
# losing it strands users who cannot install a differently-signed update without a wipe. In CI the
# file is written from repo secrets — see .github/workflows/android-release.yml.
#
# storeFile is resolved relative to the repo root (an absolute path works too — CI stores the keystore
# at that path). Keep the .jks/.keystore outside version control (the repo's .gitignore already
# excludes *.jks / *.keystore).

storeFile=../path/to/release.jks
storePassword=CHANGEME
keyAlias=CHANGEME
keyPassword=CHANGEME
